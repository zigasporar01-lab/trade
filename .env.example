# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file — it contains your wallet's private key.

# --- Mode -------------------------------------------------------------
# paper = simulated trades on real market data (safe, no funds at risk)
# live  = real trades with real money. Only set this after weeks of clean paper results.
MODE=paper

# --- Solana RPC ---------------------------------------------------------
# Public RPC endpoints are rate-limited and unreliable for trading. Use a
# provider: Helius (helius.dev), QuickNode, or Triton. Free tiers exist.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Wallet (LIVE MODE ONLY) --------------------------------------------
# Base58-encoded private key of a DEDICATED trading wallet.
# Do NOT use your main wallet. Fund it only with the small capital you're
# willing to risk. Leave blank in paper mode.
SOLANA_WALLET_PRIVATE_KEY=

# --- Jupiter swap API -----------------------------------------------------
# Free keyless tier works for low request volume: https://lite-api.jup.ag
# Get an API key at https://portal.jup.ag for higher rate limits.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://lite-api.jup.ag

# --- RugCheck (Solana token safety reports) -------------------------------
# https://rugcheck.xyz -> create an account -> generate an API key.
RUGCHECK_API_KEY=

# --- GoPlus Security (cross-check token safety) ---------------------------
# https://gopluslabs.io -> free tier available.
GOPLUS_API_KEY=

# --- X (Twitter) API v2 ----------------------------------------------------
# https://developer.x.com -> pay-per-use since Feb 2026, no free tier.
# Fund a small prepaid credit balance; the bot caches aggressively and caps
# reads per scan (see config.yaml: social.max_reads_per_token_scan).
X_BEARER_TOKEN=

# --- Alerts (optional) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
